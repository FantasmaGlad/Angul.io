{
  "name": "angulio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Angul.io — plateforme de jeu multijoueur temps reel inspiree d'Agar.io, avec systeme de salons et de modes de jeu scriptables.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "shared",
    "server",
    "client",
    "admin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
