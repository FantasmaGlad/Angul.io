DATABASE_URL=postgresql://angulio:CHANGE_ME@localhost:5432/angulio_dev
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000

# Cadence de simulation ET de diffusion des `state` (server/src/engine/room.ts) — 30 par défaut.
# La monter (ex. 60) réduit l'écart entre le dt fixe du serveur et le dt variable du rendu client
# (voir client/src/prediction.ts), donc la fenêtre de rejeu de réconciliation — au prix d'environ
# deux fois plus de CPU (boucle de tick) et de bande passante (un `state` par joueur/tick). À
# augmenter seulement si la marge CPU du serveur le permet (voir `systemctl status angulio` /
# `ps -o pcpu` en prod).
# TICK_RATE_HZ=60

# Interface d'administration (Lot 5.1) — hash argon2 du mot de passe admin, généré via
# `npm run hash-password --workspace=server -- <mot-de-passe>`. Absent : l'interface admin
# répond 503 (indisponible), le reste du serveur fonctionne normalement.
ADMIN_PASSWORD_HASH=
