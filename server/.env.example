# Interface d'administration (Lot 5.1) — hash argon2 du mot de passe admin, généré via
# `npm run hash-password --workspace=server -- <mot-de-passe>`. Absent : l'interface admin
# répond 503 (indisponible), le reste du serveur fonctionne normalement.
ADMIN_PASSWORD_HASH=
