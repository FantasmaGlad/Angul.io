{
  "name": "@angulio/server",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "loadtest": "node scripts/loadtest.mjs",
    "hash-password": "node scripts/hashPassword.mjs",
    "migrate:up": "node-pg-migrate up --envPath ./.env",
