  },
  "dependencies": {
    "@angulio/shared": "*",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "node-pg-migrate": "^9.0.0"
  }
}
